// The game's own new texts, English (the base language: every other language falls back to these).
// Nested objects; the key of a text is the path joined with dots, e.g. choices.incidents.painless.title.
// {name} placeholders are filled by the game (texts::Format); a translation may reorder them.
// A mod adds or fixes a language with its own data/texts/<lang>.json5.
{
  choices: {
    common: {
      a_colony: "a colony",
    },
    incidents: {
      painless: {
        title: "Disease without pain",
        body: "A strange disease has spread through {place}. Those who survive it feel no pain at all. Doctors can cure it, the colony can be sealed off, or the survivors can be taken as fearless troops.",
        option1: "Cure the sick ({cost} BC)",
        option1_dear: "Cure the sick ({cost} BC) - too dear, quarantine instead",
        option2: "Quarantine (morale {morale} for {turns} turns)",
        option3: "Recruit survivors (morale +{morale}, troops +{troops}, {turns} turns)",
      },
      native_drug: {
        title: "Drug of the natives",
        body: "The colonists of {place} have taken up a drug of the natives. It calms the people, but the work suffers. A ban would anger them and bring smugglers; a tax would fill the treasury.",
        option1: "Tolerate it (morale +{morale}, costs {cost} BC a turn, {turns} turns)",
        option2: "Ban it (morale {morale}, smugglers steal {loss} BC, {turns} turns)",
        option3: "Tax it (morale +{morale}, earns {cost} BC a turn, {turns} turns)",
      },
      treasury: {
        title: "A found treasury",
        body: "Your crews found {amount} BC of stolen money on a wreck. It belongs to the {race}, who do not know where it is. It can be returned, returned for a commission, or kept.",
        option1: "Return it all ({race} remember it kindly)",
        option2: "Return it, keep {percent}% ({keep} BC)",
        option3: "Keep it all (+{amount} BC, they may find out)",
      },
      deposit: {
        title: "A rich deposit",
        body: "Miners at {place} struck a rare deposit under the colony. It can be left alone, mined with care, or plundered at once.",
        option1: "Leave it alone (morale +{morale} for {turns} turns)",
        option2: "Mine with care (planet 1 mineral class richer)",
        option3: "Plunder it (2 classes richer, unrest and quakes)",
      },
      rebel_general: {
        title: "A rebel general",
        body: "Captain {name} defies orders and the crew follows. The captain can be talked round, ignored in the hope that it passes, or executed.",
        option1: "Reason with the captain (a dice check; failure is a coup)",
        option2: "Ignore the captain (in {turns} turns a coup or a trial)",
        option3: "Execute the captain (other leaders lose {fear} loyalty)",
      },
      mad_governor: {
        title: "A mad governor",
        body: "The governor {name} of {place} doses the water of the colony with something strange. Output soars, but the governor is plainly mad and the colony will pay for it.",
        option1: "Remove the governor at once",
        option2: "Keep the governor (+{bc} BC a turn for {turns} turns, then a collapse)",
      },
    },
    overtures: {
      hand: {
        title: "An outstretched hand",
        body: "A delegation of scientists from all races offers to share its work with you if you cut your fleet. You can accept the offer, bargain, or seize the delegation.",
        option1: "Accept (scrap the {ships} cheapest ships, get {apps} technologies)",
        option2: "Bargain (scrap 1 ship, get 1 technology and {bc} BC)",
        option3: "Seize them (+{bc} BC, empires you know think worse of you)",
      },
      leak: {
        title: "A leaked discovery",
        body: "One of your discoveries is about to leak to the empires that lack it (in contact: {count}). You can share it, sell it, or pay to keep it secret.",
        option1: "Share it (up to {count} empires get it and are grateful)",
        option2: "Sell it (buyer: {race}, {price} BC)",
        option2_nobuyer: "Sell it - nobody can pay {price} BC, no deal",
        option3: "Keep it secret (counterintelligence, {cost} BC)",
      },
    },
    discoveries: {
      power_plant: {
        title: "An ancient power plant",
        body: "Colonists at {place} have dug up an ancient power plant. It can be tested on a dead world, taken apart for its secrets, or installed to run the colony's industry.",
        option1: "Test it on a dead world ({cost} BC, research +{research}, {turns} turns)",
        option2: "Take it apart (dice check: a technology, or a blast on a bad failure; {turns} turns)",
        option3: "Install it (the colony gets a factory, population -1, {turns} turns)",
      },
      symbionts: {
        title: "Sleeping symbionts",
        body: "Colonists at {place} have found a ship with sleeping symbionts. The ship can be studied, the symbionts can be woken, or a volunteer can bond with one of them.",
        option1: "Study the ship (dice check, research +{research}, {turns} turns)",
        option2: "Wake them (dice check: a technology, or a hostile guardian on a bad failure; {turns} turns)",
        option3: "Bond with a volunteer (dice check, research +{research}, risk of a loss; {turns} turns)",
      },
      natives: {
        title: "Natives",
        body: "Natives live on a continent of {place}. You can leave them in peace, teach them, or put them to work.",
        option1: "Leave them alone (a gift of {gift} BC, {turns} turns)",
        option2: "Teach them ({cost} BC, {turns} turns, then a research lab)",
        option3: "Put them to work (+{bc} BC now; {percent}% risk of revolt: -1 pop, -{loss} BC)",
      },
    },
    pirate_world: {
      tribute: {
        title: "Raiders demand tribute",
        body: "Pirate raiders have found your freighter lanes and demand tribute for safe passage. You can pay, haggle, or refuse and take the raid.",
        option1: "Pay {fee} BC (peace, unless a rival at war with you outbids)",
        option2: "Haggle (offer {half} BC; {percent}% they agree, otherwise a raid)",
        option3: "Refuse (a raid at once: part of the treasury and {ships} freighters lost)",
      },
      syndicate: {
        title: "A secret base of the syndicate",
        body: "Your agents have found a secret base of the pirate syndicate on your territory. You can arrest its people, send a mole to study it, or seize it and run it yourself.",
        option1: "Arrest them (+{loot} BC at once)",
        option2: "Study it (+{bc} BC a turn for {turns} turns; {percent}% a turn the mole is found)",
        option2_busy: "Study it (you already hold a base: arrest it instead, +{loot} BC)",
        option3: "Seize it (+{bc} BC a turn for {turns} turns; its pirates raid your enemies, you get half)",
        option3_busy: "Seize it (you already hold a base: arrest it instead, +{loot} BC)",
      },
      smuggler: {
        title: "A repentant smuggler",
        body: "A smuggler who worked for the pirates comes to you, claims to have repented and offers to tell all about them. You can jail the smuggler, grant an amnesty, or use the smuggler as a guide to the pirates.",
        option1: "Jail the smuggler (+{bc} BC in fines)",
        option2: "Amnesty (+{bc} BC; every lair loses {loss} strength; {percent}% risk of a new lair)",
        option3: "Use as a guide (+{bc} BC, a new pirate lair appears for certain)",
      },
      haven: {
        title: "A pirate haven",
        body: "A pirate lair has grown into a haven and offers you its services: defectors with their knowledge, a flag of convenience, or the black market of technologies.",
        option1: "Defectors ({cost} BC for one technology)",
        option1_no: "Defectors ({cost} BC): impossible now, nothing happens",
        option2: "Flag of convenience ({cost} BC; the lairs spare you for {turns} turns)",
        option2_no: "Flag of convenience ({cost} BC): impossible now, nothing happens",
        option3: "Black market ({cost} BC for {apps} technologies; empires you know think worse of you)",
        option3_no: "Black market ({cost} BC): impossible now, nothing happens",
      },
    },
    moo_world: {
      tribute: {
        title: "The pirate king demands tribute",
        body: "The horde of the pirate king has reached your colonies and demands tribute. You can pay, haggle, or refuse and take the raid.",
        option1: "Pay {fee} BC (the king leaves you in peace this time)",
        option2: "Haggle (offer {half} BC; {percent}% the king agrees, otherwise a raid)",
        option3: "Refuse (a raid at once: part of the treasury and {ships} freighters lost)",
      },
      refugees: {
        title: "Refugees",
        body: "Refugees of the {race} people, driven out of their colony by the {aggressor} empire, ask to settle on {place}. You can take them in or turn them away.",
        option1: "Take them in (+1 {race} person; the {aggressor} think worse of you)",
        option2: "Turn them away (the {owner} will remember it)",
      },
      council: {
        title: "The council's demand",
        body: "Your use of biological weapons has shocked the galactic council. It demands that you stop using them. You can promise to stop or refuse.",
        option1: "Promise to stop (goodwill +{good}; breaking the promise later: {broke})",
        option2: "Refuse (every empire that knows you thinks worse of you: {loss})",
      },
      defection: {
        title: "A scientist asks to defect",
        body: "{name}, a scientist of the {race} empire, is fed up with the unrest at home and asks to join you, bringing the knowledge of a new technology. You can take the scientist in or send the scientist home.",
        option1: "Take in the scientist (a leader and a technology; {race} may resent it)",
        option2: "Send home ({race} will think better of you: +{good})",
      },
    },
    crises: {
      field: {
        science: "science",
        diplomacy: "diplomacy",
        army: "army",
        espionage: "espionage",
      },
      asteroid: {
        title: "An asteroid threatens the capital",
        body: "An asteroid is falling toward {place}, your capital. A few turns after your decision a check shows how it ends: on success the danger passes; on a partial success the colony loses its dearest building; on a failure the asteroid strikes the planet.",
        option1: "Build an interceptor ({cost} BC, {field}, {chance}% to succeed)",
        option1_poor: "Build an interceptor ({cost} BC): not enough BC, option 3 is taken",
        option2: "Blow it up ({cost} BC, {field}, {chance}% to succeed)",
        option2_poor: "Blow it up ({cost} BC): not enough BC, option 3 is taken",
        option3: "Evacuate with the neighbours' help ({cost} BC, {field}, {chance}% to succeed)",
      },
      parasites: {
        title: "Brain parasites",
        body: "Brain parasites have appeared among the people of {place}. A few turns after your decision a check shows how it ends. On success they are beaten (talks bring 100 research points, the weapon 2 spies at home). Otherwise they return later, and a failure first halves your accumulated research.",
        option1: "Talk to them ({cost} BC, {field}, {chance}% to succeed)",
        option2: "Find a cure ({cost} BC, {field}, {chance}% to succeed)",
        option2_poor: "Find a cure ({cost} BC): not enough BC, option 3 is taken",
        option3: "Make them a weapon ({cost} BC, {field}, {chance}%; the neighbours fear you)",
      },
      parasites_return: {
        title: "The parasites return",
        body: "The brain parasites have come back to {place}. A few turns after your decision a check shows how it ends. On success they are gone for good; on a partial success your accumulated research is halved; on a failure the colony is struck as by a comet.",
      },
      revolutionaries: {
        title: "Revolutionaries",
        body: "Revolutionaries have appeared in {place}. A few turns after your decision a check shows how it ends. On success the unrest dies down; on a partial success the treasury loses 50 BC; on a failure the revolutionaries rise 8 turns later.",
        option1: "Negotiate ({cost} BC, {field}, {chance}% to succeed)",
        option1_poor: "Negotiate ({cost} BC): not enough BC, option 3 is taken",
        option2: "Put them on trial ({cost} BC, {field}, {chance}% to succeed)",
        option3: "Execute them ({cost} BC, {field}, {chance}%; the neighbours fear you)",
      },
      revolution: {
        title: "The revolutionaries rise",
        body: "The revolutionaries of {place} have risen. A few turns after your decision a check shows how it ends. On success order is restored; on a partial success the colony's production is lost; on a failure the colony breaks away to the neighbour its people lean to, or is struck as by a comet.",
      },
      approach: {
        title: "War weariness",
        body: "The long war wears on your people: weariness {value} of {max}. At each new stage the capital's output is lost, then the treasury is fined {fine} BC, then a general strike stops the capital for {turns} turns. Weariness grows {growth} a turn; choose how to hold it back (a measure that cannot be paid for in some turn is skipped that turn).",
        option1: "Propaganda ({bc} BC a turn; weariness grows {net} a turn)",
        option2: "Martial law ({rp} research points a turn; weariness grows {net} a turn)",
        option3: "Carry on (free; weariness grows {net} a turn)",
      },
      council: {
        title: "The council's project",
        body: "The galactic council collects trophies to hold back the Antaran front: {progress} of {goal} BC so far, {given} BC of it from you. When the goal is reached the front is pushed back {push} points and every giver gets research points worth {bonus} times the gift. How much will you give?",
        option1: "Give nothing",
        option2: "Give {gift} BC",
        option2_poor: "Give {gift} BC: not enough BC, nothing is given",
        option3: "Give {gift} BC, generously",
        option3_poor: "Give {gift} BC: not enough BC, nothing is given",
      },
    },
    wanderers: {
      trader: {
        title: "A wandering trader",
        body: "A wandering trader has stopped at {place}, a star where you have a colony, and offers a technology application you do not know for {price} BC. The trader moves on in a few turns.",
        option1: "Buy it for {price} BC",
        option1_poor: "Buy it for {price} BC: not enough BC, nothing happens",
        option2: "Decline",
      },
    },
    world_events: {
      protection: {
        title: "Pirates offer protection",
        body: "Pirates paid by your enemies have raided your freighters. Now they offer protection: {fee} BC a turn for {turns} turns. If the treasury cannot pay in some turn, they raid again.",
        option1: "Pay {fee} BC a turn for {turns} turns",
        option1_poor: "Pay {fee} BC a turn: not enough BC, nothing happens",
        option2: "Refuse (no protection; a new price on your head may bring new raids)",
      },
    },
    intrigue: {
      fate: {
        title: "A spy is caught",
        body: "Your counterintelligence has caught a spy of the {race} empire. You decide the spy's fate: execute the spy, expel all their spies, or send the spy home (with the spy network technology the spy can be turned instead).",
        option1: "Execute the spy (their opinion of you {opinion})",
        option2: "Expel all their spies here ({spies}; an AI empire sends no new ones for {turns} turns)",
        option2_plain: "Expel all their spies here ({spies} go home)",
        option3_turn: "Turn the spy (for {turns} turns their operations against you are {difficulty} harder)",
        option3_home: "Send the spy home (their opinion of you +{opinion})",
        option3_home_favour: "Send the spy home (their opinion of you +{opinion}; they owe you a favour)",
      },
      letter: {
        title: "A letter about your partner",
        body_alliance: "A letter without a signature has reached you. It says that the {race} empire, your ally, is plotting against you. You can believe the letter or dismiss it.",
        body_pact: "A letter without a signature has reached you. It says that the {race} empire, which has a defence pact with you, is plotting against you. You can believe the letter or dismiss it.",
        option1: "Believe it (break the alliance with the {race})",
        option1_pact: "Believe it (end the defence pact with the {race})",
        option2: "Dismiss it (nothing changes)",
      },
      proxy: {
        title: "A war for hire",
        body: "The {race} empire is at war with the {enemy} and offers you {price} BC to go to war with them too. If you accept, you receive the money and declare war on the {enemy} at once. The {enemy} may learn who paid for it.",
        option1: "Take {price} BC and declare war on the {enemy}",
        option2: "Refuse (nothing changes)",
      },
    },
    secrets: {
      about: {
        plan: "that you are planning an attack on the {victim}",
        bribe: "that you have bribed a governor of the {victim}",
        treaty: "that you made a secret treaty against the {victim}",
        bio: "that you used biological weapons against the {victim}",
      },
      blackmail: {
        title: "Blackmail",
        body_tribute: "Agents of the {holder} have learned a secret of yours: {about}. They demand {price} BC for their silence. If you refuse, the secret is made public and the {victim} learn of it.",
        body_tech: "Agents of the {holder} have learned a secret of yours: {about}. They demand a technology for their silence. If you refuse, the secret is made public and the {victim} learn of it.",
        option1: "Pay {price} BC (the {holder} keep the secret)",
        option1_tech: "Give them a technology (the cheapest they lack; the {holder} keep the secret)",
        option1_poor: "Pay: not enough BC, the secret is made public",
        option2: "Refuse (the secret goes public; other empires' opinion of you {loss})",
      },
    },
    pacts: {
      pact: {
        title: "A defence pact is offered",
        body: "The {race} empire proposes a defence pact aimed at the {threat} empire. If you are attacked, the {race} declare war on the attacker, unless they are too weary of war. You are not bound to fight for them. The pact ends if you go to war with each other, if either empire is destroyed, or if your opinions of each other turn bad.",
        option1: "Accept (a defence pact with the {race})",
        option2: "Refuse (nothing changes; they may ask again later)",
      },
      guarantee: {
        title: "A guarantee of independence is offered",
        body: "The {race} empire, much stronger than you, offers to guarantee your independence against the {threat} empire. If you are attacked, they declare war on the attacker, unless they are too weary of war. You owe them nothing. The guarantee ends if you go to war with each other, if their opinion of you turns bad, or if you are no longer the weaker fleet.",
        option1: "Accept the guarantee of the {race}",
        option2: "Refuse (nothing changes; they may ask again later)",
      },
    },
    ambition: {
      bribe: {
        title: "A bribe for your vote",
        body: "The council is about to vote between two nominees. The {race} empire, which stands against the {rival}, offers you {price} BC for your vote. If you accept, you receive the money now and your vote goes to the {race} without a further prompt. The {rival} may find out, and then they will think worse of both of you.",
        option1: "Accept {price} BC (your vote goes to the {race})",
        option2: "Refuse (you vote as you wish)",
      },
    },
    hostages: {
      owner_leader: {
        title: "A leader of yours is held",
        body: "{leader}, a leader of yours, has been held by the {race} empire for {turns} turns. They will let the leader go for a ransom of {price} BC. A prisoner may escape on its own ({escape} percent a turn); after {limit} turns a ruthless holder may execute the leader.",
        option1: "Pay {price} BC (the leader returns to your pool)",
        option1_poor: "Pay {price} BC: not enough BC, nothing happens",
        option2: "Offer an exchange for {theirs}, whom you hold (both leaders go home)",
        option3: "Leave the leader there for now",
      },
      holder_leader: {
        title: "You hold a leader of another empire",
        body: "You have held {leader}, a leader of the {race} empire, for {turns} turns. You decide the leader's fate: execute, release, or keep holding. The {race} may buy the leader back for {price} BC.",
        option1: "Execute the leader (their opinion of you {opinion})",
        option2_release: "Release the leader (the leader goes home to the {race})",
        option2_exchange: "Exchange for {theirs} (the {race} agree; both leaders go home)",
        option3: "Keep holding",
      },
      owner_spy: {
        title: "Your spies are in prison",
        body: "The {race} empire holds {count} of your spies; the term has lasted {turns} turns. They release one spy for {price} BC. Spies may also escape on their own, and a jailer may release or execute them after a long term.",
        option1: "Pay {price} BC for one spy",
        option1_poor: "Pay {price} BC for one spy: not enough BC, nothing happens",
        option2: "Offer an exchange, one spy each (you hold {theirs} of theirs)",
        option3: "Leave them there for now",
      },
      holder_spy: {
        title: "You hold spies of another empire",
        body: "You hold {count} spies of the {race} empire; the term has lasted {turns} turns. You decide the fate of one of them: execute, release, or keep holding. The {race} may buy a spy back for {price} BC.",
        option1: "Execute a spy (their opinion of you {opinion})",
        option2_release: "Release a spy (the spy goes home to the {race})",
        option2_exchange: "Exchange a spy each (they hold {theirs} of yours; the {race} agree)",
        option3: "Keep holding",
      },
    },
  },
