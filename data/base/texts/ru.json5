// Тексты игры, русский. Те же ключи, что в en.json5; нет ключа - берётся английский.
// Показывается шрифтом русского выпуска 1.31 (кодировка CP866): только русские буквы, ASCII и
// псевдографика, без кавычек-ёлочек и длинного тире. Названия: МК (BC), мораль, казна, лидер.
// Подстановки {имя} заполняет игра; порядок в переводе можно менять.
{
  choices: {
    common: {
      a_colony: "одной из колоний",
    },
    incidents: {
      painless: {
        title: "Болезнь без боли",
        body: "На {place} распространилась странная болезнь: переболевшие совсем не чувствуют боли. Врачи могут вылечить больных, колонию можно закрыть на карантин, а выживших - взять в бесстрашные войска.",
        option1: "Вылечить больных ({cost} МК)",
        option1_dear: "Вылечить больных ({cost} МК) - не хватает денег, будет карантин",
        option2: "Карантин (мораль {morale}, ходов: {turns})",
