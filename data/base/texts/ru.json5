// Тексты игры, русский. Те же ключи, что в en.json5; нет ключа - берётся английский.
// Показывается шрифтом русского выпуска 1.31 (кодировка CP866): только русские буквы, ASCII и
// псевдографика, без кавычек-ёлочек и длинного тире. Названия: МК (BC), мораль, казна, лидер.
// Подстановки {имя} заполняет игра; порядок в переводе можно менять.
{
  choices: {
    common: {
      a_colony: "одной из колоний",
    },
    incidents: {
      painless: {
        title: "Болезнь без боли",
        body: "На {place} распространилась странная болезнь: переболевшие совсем не чувствуют боли. Врачи могут вылечить больных, колонию можно закрыть на карантин, а выживших - взять в бесстрашные войска.",
        option1: "Вылечить больных ({cost} МК)",
        option1_dear: "Вылечить больных ({cost} МК) - не хватает денег, будет карантин",
        option2: "Карантин (мораль {morale}, ходов: {turns})",
        option3: "Набрать выживших (мораль +{morale}, войска +{troops}, ходов: {turns})",
      },
      native_drug: {
        title: "Наркотик туземцев",
        body: "Колонисты на {place} пристрастились к наркотику туземцев. Он успокаивает людей, но работа страдает. Запрет рассердит колонистов и приведет контрабандистов, а налог пополнит казну.",
        option1: "Терпеть (мораль +{morale}, {cost} МК в ход, ходов: {turns})",
        option2: "Запретить (мораль {morale}, контрабандисты крадут {loss} МК, ходов: {turns})",
        option3: "Обложить налогом (мораль +{morale}, +{cost} МК в ход, ходов: {turns})",
      },
      treasury: {
        title: "Найденная казна",
        body: "Ваши экипажи нашли на обломках {amount} МК краденых денег. Хозяева, {race}, не знают, где их деньги. Можно вернуть все, вернуть за комиссию или оставить себе.",
        option1: "Вернуть все ({race} запомнят добро)",
        option2: "Вернуть, оставив {percent}% ({keep} МК)",
        option3: "Оставить все себе (+{amount} МК, хозяева могут узнать)",
      },
      deposit: {
        title: "Богатое месторождение",
        body: "Шахтеры на {place} наткнулись под колонией на редкое месторождение. Его можно не трогать, добывать осторожно или разграбить сразу.",
        option1: "Не трогать (мораль +{morale}, ходов: {turns})",
        option2: "Добывать осторожно (планета богаче минералами на 1 класс)",
        option3: "Разграбить (богаче на 2 класса, волнения и землетрясения)",
      },
      rebel_general: {
        title: "Мятежный генерал",
        body: "Капитан {name} не подчиняется приказам, и экипаж стоит за капитаном. Можно уговорить, закрыть глаза в надежде, что все уладится, или казнить.",
        option1: "Уговорить (бросок кубиков; провал - переворот)",
        option2: "Закрыть глаза (ходов до переворота или суда: {turns})",
        option3: "Казнить (остальные лидеры теряют {fear} лояльности)",
      },
      mad_governor: {
        title: "Безумный губернатор",
        body: "Губернатор {name} на {place} подмешивает в воду колонии что-то странное. Производство растет, но рассудок губернатора явно помутился, и колония за это заплатит.",
        option1: "Немедленно отстранить губернатора",
        option2: "Оставить (+{bc} МК в ход, ходов: {turns}, затем крах)",
      },
    },
    overtures: {
      hand: {
        title: "Протянутая рука",
        body: "Делегация ученых всех рас предлагает поделиться своими работами, если вы сократите флот. Можно принять предложение, поторговаться или захватить делегацию.",
        option1: "Принять (списать самые дешевые корабли: {ships}, получить технологий: {apps})",
        option2: "Поторговаться (списать 1 корабль, получить 1 технологию и {bc} МК)",
        option3: "Захватить (+{bc} МК, знакомые империи отнесутся к вам хуже)",
      },
      leak: {
        title: "Утечка открытия",
        body: "Одно из ваших открытий вот-вот станет известно империям, у которых его нет (знакомых: {count}). Можно поделиться им, продать или заплатить за сохранение тайны.",
        option1: "Поделиться (получат империи: {count}, они будут благодарны)",
        option2: "Продать (покупатель: {race}, {price} МК)",
        option2_nobuyer: "Продать - ни у кого нет {price} МК, сделки не будет",
        option3: "Сохранить тайну (контрразведка, {cost} МК)",
      },
    },
    discoveries: {
      power_plant: {
        title: "Древняя электростанция",
        body: "Колонисты на {place} раскопали древнюю электростанцию. Ее можно испытать на мертвом мире, разобрать ради ее секретов или установить, чтобы она питала промышленность колонии.",
        option1: "Испытать на мертвом мире ({cost} МК, исследования +{research}, ходов: {turns})",
        option2: "Разобрать (бросок: технология, при сильном провале взрыв; ходов: {turns})",
        option3: "Установить (колония получит завод, население -1, ходов: {turns})",
      },
      symbionts: {
        title: "Спящие симбионты",
        body: "Колонисты на {place} нашли корабль со спящими симбионтами. Корабль можно изучить, симбионтов разбудить, а доброволец может слиться с одним из них.",
        option1: "Изучить корабль (бросок, исследования +{research}, ходов: {turns})",
        option2: "Разбудить (бросок: технология, при сильном провале враждебный страж; ходов: {turns})",
        option3: "Слияние с добровольцем (бросок, исследования +{research}, риск потерь; ходов: {turns})",
      },
      natives: {
        title: "Туземцы",
        body: "На {place} обнаружены туземцы. Их можно оставить в покое, обучить или заставить работать.",
        option1: "Оставить в покое (подарок {gift} МК, ходов: {turns})",
        option2: "Обучить ({cost} МК, ходов: {turns}, затем научная лаборатория)",
        option3: "Заставить работать (+{bc} МК сразу; риск бунта {percent}%: жители -1, казна -{loss} МК)",
      },
    },
    pirate_world: {
      tribute: {
        title: "Рейдеры требуют дань",
        body: "Пиратские рейдеры выследили ваши торговые маршруты и требуют дань за спокойный проход. Можно заплатить, поторговаться или отказать и принять налет.",
        option1: "Заплатить {fee} МК (мир, если воюющий с вами враг не перекупит рейдеров)",
        option2: "Поторговаться (предложить {half} МК; согласие в {percent}% случаев, иначе налет)",
        option3: "Отказать (налет сразу: потеря части казны и грузовых кораблей: {ships})",
      },
      syndicate: {
        title: "Тайная база синдиката",
        body: "Ваши агенты обнаружили на вашей территории тайную базу пиратского синдиката. Можно арестовать ее людей, внедрить крота и изучать базу или захватить ее и управлять ею самим.",
        option1: "Арестовать (+{loot} МК сразу)",
        option2: "Изучать (+{bc} МК в ход, ходов: {turns}; крота раскроют с шансом {percent}% в ход)",
        option2_busy: "Изучать (у вас уже есть такая база, ее арестуют: +{loot} МК)",
        option3: "Захватить (+{bc} МК в ход, ходов: {turns}; пираты грабят ваших врагов, вам половина)",
        option3_busy: "Захватить (у вас уже есть такая база, ее арестуют: +{loot} МК)",
      },
      smuggler: {
        title: "Раскаявшийся контрабандист",
        body: "К вам пришел контрабандист, работавший на пиратов: он говорит, что раскаялся, и предлагает рассказать о пиратах все. Контрабандиста можно посадить, объявить амнистию или использовать как проводника к пиратам.",
        option1: "Посадить (+{bc} МК штрафа)",
        option2: "Амнистия (+{bc} МК; все логова слабеют на {loss}; {percent}% риск нового логова)",
        option3: "Использовать как проводника (+{bc} МК, новое логово пиратов появится наверняка)",
      },
      haven: {
        title: "Пиратская гавань",
        body: "Пиратское логово выросло в гавань и предлагает вам свои услуги: перебежчиков со знаниями, удобный флаг или черный рынок технологий.",
        option1: "Перебежчики ({cost} МК за одну технологию)",
        option1_no: "Перебежчики ({cost} МК): сейчас невозможно, ничего не произойдет",
        option2: "Удобный флаг ({cost} МК; логова не тронут вас ходов: {turns})",
        option2_no: "Удобный флаг ({cost} МК): сейчас невозможно, ничего не произойдет",
        option3: "Черный рынок ({cost} МК за технологий: {apps}; знакомые империи станут хуже к вам относиться)",
        option3_no: "Черный рынок ({cost} МК): сейчас невозможно, ничего не произойдет",
      },
    },
    moo_world: {
      tribute: {
        title: "Пиратский король требует дань",
        body: "Орда пиратского короля добралась до ваших колоний и требует дань. Можно заплатить, поторговаться или отказать и принять налет.",
        option1: "Заплатить {fee} МК (на этот раз король оставит вас в покое)",
        option2: "Поторговаться (предложить {half} МК; король согласится в {percent}% случаев, иначе налет)",
        option3: "Отказать (налет сразу: потеря части казны и грузовых кораблей: {ships})",
      },
      refugees: {
        title: "Беженцы",
        body: "Беженцы расы {race}, изгнанные из своей колонии империей {aggressor}, просят поселиться на {place}. Можно принять их или отказать.",
        option1: "Принять (+1 житель расы {race}; империя {aggressor} станет хуже к вам относиться)",
        option2: "Отказать (империя {owner} запомнит это)",
      },
      council: {
        title: "Требование Совета",
        body: "Применение вами биологического оружия потрясло Галактический совет. Совет требует прекратить его применять. Можно пообещать это или отказаться.",
        option1: "Пообещать (добрая память: +{good}; нарушив обещание позже: {broke})",
        option2: "Отказаться (знакомые империи станут хуже к вам относиться: {loss})",
